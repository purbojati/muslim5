    "Salah Focus shared storage is unavailable. Check the App Group entitlement.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan bersama Salah Focus tidak tersedia. Periksa hak akses App Group."
          }
        }
      }
    },
    "salah": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "salat"
          }
        }
      }
    },
    "“Prayer at its proper time.” — Sahih al-Bukhari 527\n\nPray %@, then mark it complete in Muslim 5 to unlock your apps.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Salat pada waktunya.” — Sahih al-Bukhari 527\n\nTunaikan %@, lalu tandai selesai di Muslim 5 untuk membuka kembali aplikasi."
          }
        }
      }
    }
  },
  "version": "1.2"
