{
  "name": "salah-streak-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "cf-typegen": "wrangler types",
    "cf-typecheck": "wrangler types --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply salah-streak --local",
    "db:migrate:remote": "wrangler d1 migrations apply salah-streak --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.125.0"
  }
}
