    "Alhamdulillah for that consistency. Let it help you strengthen the other prayers too.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alhamdulillah atas kebiasaan baik itu. Semoga ini membantu menjaga waktu salat lainnya juga."
          }
        }
      }
    },
    "Alhamdulillah for this one. Keep the next prayer close.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alhamdulillah untuk salat ini. Mari jaga waktu salat berikutnya."
          }
        }
      }
    },
    "Alhamdulillah — all five prayers recorded.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
