    "Allow Screen Time access before turning on Salah Focus.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses Durasi Layar sebelum mengaktifkan Salah Focus."
          }
        }
      }
    },
    "Allow location access so we can calculate the Qibla from where you are.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses lokasi agar arah kiblat dapat dihitung dari tempatmu berada."
          }
        }
      }
    },
    "Allow location in Settings to calculate the prayer windows around you.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan lokasi di Pengaturan untuk menghitung rentang waktu salat di sekitarmu."
