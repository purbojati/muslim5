        }
      }
    },
    "Apple requires this permission to pause apps. Muslim 5 cannot see your Screen Time activity.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple memerlukan izin ini untuk menjeda aplikasi. Muslim 5 tidak dapat melihat aktivitas Durasi Layarmu."
