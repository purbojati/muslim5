      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat yang lembut"
          }
        }
      }
    },
    "A gentle reminder at each selected prayer time. Sound and vibration follow your iPhone settings.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat lembut di setiap waktu salat yang dipilih. Suara dan getaran mengikuti pengaturan iPhone."
          }
        }
      }
    },
    "A good start, Alhamdulillah": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Awal yang baik, Alhamdulillah"
          }
        }
      }
    },
    "A missed day doesn’t erase your effort. Begin again with the next salah.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu hari yang terlewat tidak menghapus ikhtiarmu. Mulai lagi di waktu salat berikutnya."
          }
        }
      }
    },
    "A simple reminder": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat sederhana"
